---
const services = [
  {
    name: 'Manicura + Semipermanente',
    price: '20€',
    duration: '1h',
    description: 'Limado, cutícula y esmaltado que dura semanas.',
  },
  {
    name: 'Refuerzo y Nivelación + Semipermanente',
    price: '25€',
    duration: '1h',
    description: 'Para uñas más resistentes con acabado natural.',
  },
  {
    name: 'Pedicura Semipermanente',
    price: '25€',
    duration: '1h',
    description: 'Tratamiento completo de durezas más esmaltado duradero.',
  },
  {
    name: 'Uñas acrílicas / acrygel / softgel',
    price: 'Desde 33€',
    duration: '1h30',
    description: 'Extensiones con esmaltado francesa o diseño simple.',
  },
  {
    name: 'Forrado con gel sobre uña natural',
    price: '28€',
    duration: '1h30',
    description: 'Para mantener el largo sin riesgo de rotura.',
  },
  {
    name: 'Uñas acrílicas Full Diseño',
    price: '40€',
    duration: '2h',
    description: 'El diseño que imaginas, hecho realidad.',
  },
];
---

<section class="services section section--soft" id="servicios">
  <div class="container">
    <p class="eyebrow">Servicios</p>
    <h2 class="section-title">Esto es lo que hacemos por ti</h2>

    <div class="services-list">
      {services.map((service, i) => (
        <div class="service-row">
          <span class="service-index">{String(i + 1).padStart(2, '0')}</span>
          <div class="service-body">
            <div class="service-head">
              <h3 class="service-name">{service.name}</h3>
              <span class="service-price">{service.price} · {service.duration}</span>
            </div>
            <p class="service-description">{service.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services-list {
    margin-top: 56px;
  }

  .service-row {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 28px;
    padding: 40px 0;
    border-top: 1px solid rgba(42, 37, 33, 0.16);
  }

  .service-row:last-child {
    border-bottom: 1px solid rgba(42, 37, 33, 0.16);
  }

  .service-index {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.6rem;
    color: var(--color-terracota);
  }

  .service-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  .service-name {
    font-size: clamp(1.3rem, 2.4vw, 1.6rem);
    font-style: italic;
    font-weight: 400;
    color: var(--color-charcoal);
  }

  .service-price {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.02em;
    color: var(--color-terracota);
    white-space: nowrap;
  }

  .service-description {
    margin-top: 12px;
    font-size: 1rem;
    color: rgba(42, 37, 33, 0.75);
    max-width: 56ch;
  }

  @media (max-width: 560px) {
    .service-row {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }
</style>
