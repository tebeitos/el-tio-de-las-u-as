---
const BOOKSY_URL = 'https://booksy.com/es-es/83914_el-tio-de-las-unas_salon-de-unas_76596_gijon';

const reviews = [
  { quote: 'Son todos de 10. Las mejores uñas que me han hecho.', author: 'Natalia' },
  { quote: 'Trato inmejorable. Totalmente recomendado.', author: 'Laura' },
  { quote: 'Como siempre, trabajan muy bien. Profesionales con amabilidad y simpatía.', author: 'María Eugenia' },
];
---

<section class="reviews section" id="resenas">
  <div class="container reviews-top">
    <p class="eyebrow">Reseñas</p>
    <div class="rating">
      <span class="rating-score">4,9★</span>
      <span class="rating-count">269 reseñas</span>
    </div>
  </div>

  <div class="reviews-list">
    {reviews.map((review, i) => (
      <>
        <div class="container">
          <blockquote class="review-quote-block">
            <p class="quote">&ldquo;{review.quote}&rdquo;</p>
            <cite class="quote-cite">— {review.author}</cite>
          </blockquote>
        </div>
        {i < reviews.length - 1 && <div class="review-divider"></div>}
      </>
    ))}
  </div>

  <div class="container reviews-cta">
    <a href={BOOKSY_URL} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
      → Ver todas las reseñas en Booksy
    </a>
  </div>
</section>

<style>
  .reviews {
    background-color: var(--color-cream);
    text-align: center;
  }

  .rating {
    margin-top: 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .rating-score {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(2.6rem, 6vw, 4rem);
    color: var(--color-green);
  }

  .rating-count {
    font-size: 0.95rem;
    color: rgba(22, 36, 27, 0.6);
    letter-spacing: 0.02em;
  }

  .reviews-list {
    margin-top: 72px;
  }

  .review-quote-block {
    margin: 0 auto;
    padding: 56px 0;
  }

  .review-divider {
    width: 100%;
    height: 1px;
    background-color: rgba(22, 36, 27, 0.14);
    max-width: 1180px;
    margin: 0 auto;
  }

  .reviews-cta {
    margin-top: 72px;
  }
</style>
