---
const BOOKSY_URL = 'https://booksy.com/es-es/83914_el-tio-de-las-unas_salon-de-unas_76596_gijon';
---

<a
  href={BOOKSY_URL}
  target="_blank"
  rel="noopener noreferrer"
  class="floating-btn"
  aria-label="Reservar cita en Booksy"
>
  Reservar
</a>

<style>
  .floating-btn {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 50;
    background-color: var(--color-gold);
    color: var(--color-black);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.9rem;
    padding: 14px 26px;
    border-radius: 999px;
    box-shadow: 0 10px 30px -8px rgba(0, 0, 0, 0.6);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .floating-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 34px -8px rgba(201, 168, 76, 0.55);
  }

  @media (max-width: 480px) {
    .floating-btn {
      right: 14px;
      bottom: 14px;
      padding: 12px 20px;
      font-size: 0.85rem;
    }
  }
</style>
