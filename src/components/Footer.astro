---
import fs from 'node:fs';
import path from 'node:path';

const logoPath = path.join(process.cwd(), 'public', 'logo.png');
const hasLogo = fs.existsSync(logoPath);

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    {hasLogo ? (
      <span class="footer-logo-badge">
        <img src="/logo.png" alt="El Tío de las Uñas" class="footer-logo" />
      </span>
    ) : (
      <span class="footer-logo-placeholder">El Tío de las Uñas</span>
    )}

    <p class="footer-line">Avenida de la Costa 125, Gijón</p>
    <p class="footer-line footer-handle">@eltiodelasunas</p>

    <nav class="footer-links">
      <a href="/aviso-legal">Aviso legal</a>
      <span class="footer-sep">·</span>
      <a href="/privacidad">Privacidad</a>
      <span class="footer-sep">·</span>
      <span>© {year} El Tío de las Uñas</span>
    </nav>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-ink);
    padding: 88px 0 64px;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 18px;
  }

  .footer-logo-badge {
    display: inline-flex;
    background-color: var(--color-cream);
    padding: 14px 22px;
    border-radius: 6px;
  }

  .footer-logo {
    max-width: 110px;
    width: 100%;
    height: auto;
  }

  .footer-logo-placeholder {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 500;
    font-size: 1.5rem;
    color: var(--color-cream);
  }

  .footer-line {
    font-family: var(--font-heading);
    font-style: italic;
    color: rgba(245, 241, 230, 0.85);
    font-size: 1.05rem;
  }

  .footer-handle {
    color: var(--color-green-soft);
    font-style: normal;
    font-family: var(--font-body);
    letter-spacing: 0.04em;
  }

  .footer-links {
    margin-top: 22px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.78rem;
    color: rgba(245, 241, 230, 0.5);
    flex-wrap: wrap;
    justify-content: center;
  }

  .footer-links a:hover {
    color: var(--color-green-soft);
  }

  .footer-sep {
    opacity: 0.5;
  }
</style>
