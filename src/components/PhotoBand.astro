---
interface Props {
  images?: { src: string; alt: string }[];
}

const {
  images = [
    { src: '/work-1.jpg', alt: 'Trabajo de uñas en El Tío de las Uñas' },
    { src: '/work-2.jpg', alt: 'Trabajo de uñas en El Tío de las Uñas' },
    { src: '/work-3.jpg', alt: 'Trabajo de uñas en El Tío de las Uñas' },
  ],
} = Astro.props;
---

<section class="photo-band">
  {images.map((image) => (
    <div class="photo-band-item">
      <img src={image.src} alt={image.alt} loading="lazy" />
    </div>
  ))}
</section>

<style>
  .photo-band {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .photo-band-item {
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .photo-band-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 720px) {
    .photo-band {
      grid-template-columns: 1fr;
    }
  }
</style>
