---
import fs from 'node:fs';
import path from 'node:path';

const logoPath = path.join(process.cwd(), 'public', 'logo.png');
const hasLogo = fs.existsSync(logoPath);

const BOOKSY_URL = 'https://booksy.com/es-es/83914_el-tio-de-las-unas_salon-de-unas_76596_gijon';

const navLinks = [
  { label: 'Servicios', href: '/#servicios' },
  { label: 'Reseñas', href: '/#resenas' },
  { label: 'Equipo', href: '/#equipo' },
  { label: 'Dónde estamos', href: '/#donde-estamos' },
];
---

<input type="checkbox" id="nav-toggle" class="nav-toggle-input" />

<header class="header">
  <div class="container header-inner">
    <label for="nav-toggle" class="nav-toggle-btn" aria-label="Abrir menú">
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </label>

    <a href="/" class="logo-link" aria-label="El Tío de las Uñas · Inicio">
      {hasLogo ? (
        <img src="/logo.png" alt="El Tío de las Uñas" class="logo-img" />
      ) : (
        <span class="logo-stack">
          <span class="logo-name">El Tío de las Uñas</span>
          <span class="logo-sub">Salón de Uñas</span>
        </span>
      )}
    </a>
  </div>
</header>

<div class="nav-overlay">
  <label for="nav-toggle" class="nav-close" aria-label="Cerrar menú">Cerrar ✕</label>
  <nav class="nav-links">
    {navLinks.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
    <a href={BOOKSY_URL} target="_blank" rel="noopener noreferrer" class="btn btn-green nav-cta">
      → Reservar cita
    </a>
  </nav>
</div>

<style>
  .nav-toggle-input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .header {
    position: relative;
    z-index: 40;
    background-color: var(--color-cream);
    border-bottom: 1px solid rgba(22, 36, 27, 0.1);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 18px;
    padding-bottom: 18px;
  }

  .nav-toggle-btn {
    display: flex;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    padding: 8px;
    margin-left: -8px;
  }

  .nav-toggle-btn .bar {
    display: block;
    width: 26px;
    height: 1.5px;
    background-color: var(--color-ink);
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .logo-link {
    display: flex;
    align-items: center;
  }

  .logo-img {
    max-width: 140px;
    width: 100%;
    height: auto;
  }

  .logo-stack {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    line-height: 1.3;
  }

  .logo-name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--color-green);
    white-space: nowrap;
  }

  .logo-sub {
    font-family: var(--font-body);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--color-ink);
    opacity: 0.6;
  }

  .nav-overlay {
    position: fixed;
    inset: 0;
    z-index: 60;
    background-color: var(--color-cream);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 34px;
    transform: translateY(-100%);
    transition: transform 0.4s ease;
  }

  .nav-toggle-input:checked ~ .nav-overlay {
    transform: translateY(0);
  }

  .nav-toggle-input:checked ~ header .nav-toggle-btn .bar:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }

  .nav-toggle-input:checked ~ header .nav-toggle-btn .bar:nth-child(2) {
    opacity: 0;
  }

  .nav-toggle-input:checked ~ header .nav-toggle-btn .bar:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  .nav-close {
    position: absolute;
    top: 26px;
    right: 24px;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-ink);
    cursor: pointer;
  }

  .nav-links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
  }

  .nav-links a {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: clamp(1.8rem, 5vw, 2.6rem);
    color: var(--color-ink);
    transition: color 0.2s ease;
  }

  .nav-links a:hover {
    color: var(--color-green);
  }

  .nav-cta {
    margin-top: 12px;
    font-family: var(--font-body);
    font-style: normal;
    font-size: 0.92rem;
  }

  @media (max-width: 480px) {
    .logo-name {
      font-size: 1rem;
    }
  }
</style>
