---
import fs from 'node:fs';
import path from 'node:path';

const logoPath = path.join(process.cwd(), 'public', 'logo.png');
const hasLogo = fs.existsSync(logoPath);

const BOOKSY_URL = 'https://booksy.com/es-es/83914_el-tio-de-las-unas_salon-de-unas_76596_gijon';
---

<header class="header">
  <div class="container header-inner">
    <a href="/" class="logo-link" aria-label="El Tío de las Uñas · Inicio">
      {hasLogo ? (
        <img src="/logo.png" alt="El Tío de las Uñas" class="logo-img" />
      ) : (
        <span class="logo-placeholder">El Tío de las Uñas</span>
      )}
    </a>
    <a href={BOOKSY_URL} target="_blank" rel="noopener noreferrer" class="btn btn-gold header-cta">
      Reservar cita
    </a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    background-color: rgba(13, 13, 13, 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(201, 168, 76, 0.18);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    padding-bottom: 14px;
  }

  .logo-link {
    display: flex;
    align-items: center;
  }

  .logo-img {
    max-width: 140px;
    width: 100%;
    height: auto;
  }

  .logo-placeholder {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.3rem;
    color: var(--color-gold);
    white-space: nowrap;
  }

  .header-cta {
    padding: 10px 22px;
    font-size: 0.85rem;
  }

  @media (max-width: 480px) {
    .logo-placeholder {
      font-size: 1.05rem;
    }
    .header-cta {
      padding: 9px 16px;
      font-size: 0.78rem;
    }
  }
</style>
