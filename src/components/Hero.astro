---
const BOOKSY_URL = 'https://booksy.com/es-es/83914_el-tio-de-las-unas_salon-de-unas_76596_gijon';
---

<section class="hero">
  <div class="hero-bg">
    <img src="/hero.jpg" alt="Uñas trabajadas en El Tío de las Uñas" class="hero-img" />
  </div>
  <div class="hero-overlay"></div>
  <div class="container hero-content">
    <h1 class="hero-title">Las uñas que se notan.</h1>
    <p class="hero-subtitle">El Tío de las Uñas · Gijón · 4,9★ en 269 reseñas</p>
    <a href={BOOKSY_URL} target="_blank" rel="noopener noreferrer" class="btn btn-gold hero-cta">
      Reservar cita
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background-color: var(--color-black);
  }

  .hero-bg,
  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(13, 13, 13, 0.35) 0%, rgba(13, 13, 13, 0.55) 45%, rgba(13, 13, 13, 0.94) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding-bottom: 88px;
    padding-top: 220px;
  }

  .hero-title {
    font-size: clamp(2.6rem, 7vw, 5rem);
    color: var(--color-bone);
    max-width: 14ch;
  }

  .hero-subtitle {
    margin-top: 18px;
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: var(--color-gold);
    letter-spacing: 0.02em;
    font-weight: 500;
  }

  .hero-cta {
    margin-top: 36px;
  }

  @media (max-width: 640px) {
    .hero-content {
      padding-top: 140px;
      padding-bottom: 56px;
    }
  }
</style>
