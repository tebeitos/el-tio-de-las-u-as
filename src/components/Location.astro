---
const BOOKSY_URL = 'https://booksy.com/es-es/83914_el-tio-de-las-unas_salon-de-unas_76596_gijon';
const address = 'Avenida de la Costa 125, 33203 Gijón';
const mapsEmbedSrc = `https://maps.google.com/maps?q=${encodeURIComponent(address)}&t=&z=15&ie=UTF8&iwloc=&output=embed`;
---

<section class="location section section--soft" id="donde-estamos">
  <div class="container location-inner">
    <div class="location-info">
      <p class="eyebrow">Dónde estamos</p>
      <h2 class="section-title">Ven a vernos</h2>

      <p class="location-address">Avenida de la Costa 125, 33203, Gijón</p>

      <div class="location-hours">
        <p class="location-hours-title">Horario</p>
        <p>Lunes a viernes: 10:00-14:00 · 16:00-20:00</p>
      </div>

      <a href={BOOKSY_URL} target="_blank" rel="noopener noreferrer" class="btn btn-terracota location-cta">
        → Reservar cita
      </a>
    </div>

    <div class="location-map">
      <iframe
        src={mapsEmbedSrc}
        width="100%"
        height="100%"
        style="border:0;"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Mapa de El Tío de las Uñas en Gijón"
      ></iframe>
    </div>
  </div>
</section>

<style>
  .location-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  .location-address {
    margin-top: 24px;
    font-size: 1.15rem;
    font-style: italic;
    font-family: var(--font-heading);
    color: var(--color-charcoal);
  }

  .location-hours {
    margin-top: 32px;
  }

  .location-hours-title {
    color: var(--color-terracota);
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .location-hours p:not(.location-hours-title) {
    margin-top: 10px;
    color: rgba(42, 37, 33, 0.75);
  }

  .location-cta {
    margin-top: 40px;
  }

  .location-map {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    filter: grayscale(0.3) contrast(1.05);
  }

  @media (max-width: 820px) {
    .location-inner {
      grid-template-columns: 1fr;
    }
    .location-map {
      order: -1;
    }
  }
</style>
