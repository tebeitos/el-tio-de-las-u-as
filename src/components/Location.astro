---
const BOOKSY_URL = 'https://booksy.com/es-es/83914_el-tio-de-las-unas_salon-de-unas_76596_gijon';
const address = 'Avenida de la Costa 125, 33203 Gijón';
const mapsEmbedSrc = `https://maps.google.com/maps?q=${encodeURIComponent(address)}&t=&z=15&ie=UTF8&iwloc=&output=embed`;
---

<section class="location section" id="donde-estamos">
  <div class="container location-inner">
    <div class="location-info">
      <p class="eyebrow">Dónde estamos</p>
      <h2 class="section-title">Ven a vernos</h2>

      <p class="location-address">Avenida de la Costa 125, 33203, Gijón</p>

      <div class="location-hours">
        <p class="location-hours-title">Horario</p>
        <p>Lunes a viernes: 10:00-14:00 · 16:00-20:00</p>
      </div>

      <a href={BOOKSY_URL} target="_blank" rel="noopener noreferrer" class="btn btn-gold location-cta">
        Reservar cita
      </a>
    </div>

    <div class="location-map">
      <iframe
        src={mapsEmbedSrc}
        width="100%"
        height="100%"
        style="border:0;"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Mapa de El Tío de las Uñas en Gijón"
      ></iframe>
    </div>
  </div>
</section>

<style>
  .location {
    background-color: var(--color-black);
  }

  .location-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .location-address {
    margin-top: 20px;
    font-size: 1.1rem;
    color: var(--color-bone);
  }

  .location-hours {
    margin-top: 28px;
  }

  .location-hours-title {
    color: var(--color-gold);
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .location-hours p:not(.location-hours-title) {
    margin-top: 8px;
    color: rgba(245, 240, 234, 0.82);
  }

  .location-cta {
    margin-top: 36px;
  }

  .location-map {
    aspect-ratio: 4 / 3;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(201, 168, 76, 0.2);
  }

  @media (max-width: 820px) {
    .location-inner {
      grid-template-columns: 1fr;
    }
    .location-map {
      order: -1;
    }
  }
</style>
