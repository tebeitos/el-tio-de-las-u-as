---
const team = [
  {
    name: 'Josepth Herrera',
    photo: '/josepth-herrera.jpg',
    bio: 'Especialista en manicura clásica, semipermanente, nail art y cuidado integral. Técnica precisa, estilo impecable y atención al detalle en cada servicio.',
  },
  {
    name: 'Josepth Suarez',
    photo: '/josepth-suarez.jpg',
    bio: 'Próximamente',
  },
];
---

<section class="team section" id="equipo">
  <div class="container">
    <p class="eyebrow">Equipo</p>
    <h2 class="section-title">Quiénes somos</h2>

    <div class="team-grid">
      {team.map((member) => (
        <div class="team-card">
          <div class="team-photo-wrap">
            <img src={member.photo} alt={member.name} class="team-photo" />
          </div>
          <h3 class="team-name">{member.name}</h3>
          <p class="team-bio">{member.bio}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .team {
    background-color: var(--color-dark-secondary);
  }

  .team-grid {
    margin-top: 44px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 36px;
  }

  .team-photo-wrap {
    aspect-ratio: 4 / 5;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(201, 168, 76, 0.2);
  }

  .team-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .team-name {
    margin-top: 20px;
    font-size: 1.3rem;
    color: var(--color-gold);
  }

  .team-bio {
    margin-top: 10px;
    font-size: 0.95rem;
    color: rgba(245, 240, 234, 0.82);
  }
</style>
