---
const team = [
  {
    name: 'Josepth Herrera',
    photo: '/josepth-herrera.jpg',
    bio: 'Especialista en manicura clásica, semipermanente, nail art y cuidado integral. Técnica precisa, estilo impecable y atención al detalle en cada servicio.',
  },
  {
    name: 'Josepth Suarez',
    photo: '/josepth-suarez.jpg',
    bio: 'Próximamente.',
  },
];
---

<section class="team section" id="equipo">
  <div class="container team-intro">
    <p class="eyebrow">Equipo</p>
    <h2 class="section-title">Quiénes somos</h2>
  </div>

  <div class="team-grid">
    {team.map((member) => (
      <div class="team-card">
        <div class="team-photo-wrap">
          <img src={member.photo} alt={member.name} class="team-photo" />
        </div>
        <div class="team-text">
          <h3 class="team-name">{member.name}</h3>
          <p class="team-bio">{member.bio}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .team {
    background-color: var(--color-cream);
  }

  .team-intro {
    margin-bottom: 56px;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .team-card {
    display: flex;
    flex-direction: column;
  }

  .team-photo-wrap {
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .team-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .team-text {
    padding: 32px 40px;
  }

  .team-name {
    font-style: italic;
    font-weight: 400;
    font-size: 1.6rem;
    color: var(--color-ink);
  }

  .team-bio {
    margin-top: 14px;
    font-size: 0.98rem;
    color: rgba(22, 36, 27, 0.75);
  }

  @media (max-width: 720px) {
    .team-grid {
      grid-template-columns: 1fr;
    }

    .team-text {
      padding: 28px 24px;
    }
  }
</style>
