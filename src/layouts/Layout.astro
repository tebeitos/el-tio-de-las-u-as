---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'El Tío de las Uñas · Salón de uñas en Gijón · 4,9★',
  description = 'Salón de uñas en Gijón con 4,9 estrellas y 269 reseñas. Manicura, pedicura, acrílicas y nail art. Reserva online en Booksy.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/hero.jpg', Astro.site)} />
    <meta property="og:locale" content="es_ES" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,500&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'NailSalon',
      name: 'El Tío de las Uñas',
      image: new URL('/hero.jpg', Astro.site).toString(),
      logo: new URL('/logo.png', Astro.site).toString(),
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Avenida de la Costa 125',
        addressLocality: 'Gijón',
        postalCode: '33203',
        addressRegion: 'Asturias',
        addressCountry: 'ES',
      },
      telephone: '',
      priceRange: '€€',
      url: canonicalURL.toString(),
      sameAs: ['https://www.instagram.com/eltiodelasunas', 'https://booksy.com/es-es/83914_el-tio-de-las-unas_salon-de-unas_76596_gijon'],
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: '4.9',
        reviewCount: '269',
      },
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
          opens: '10:00',
          closes: '14:00',
        },
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
          opens: '16:00',
          closes: '20:00',
        },
      ],
    })} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --color-black: #0d0d0d;
    --color-bone: #f5f0ea;
    --color-gold: #c9a84c;
    --color-dark-secondary: #1a1a1a;

    --font-heading: 'Playfair Display', serif;
    --font-body: 'Inter', sans-serif;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background-color: var(--color-black);
    color: var(--color-bone);
    font-family: var(--font-body);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  h1, h2, h3, h4 {
    font-family: var(--font-heading);
    font-weight: 600;
    line-height: 1.15;
    margin: 0;
  }

  p {
    margin: 0;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    max-width: 100%;
    display: block;
  }

  .container {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .section {
    padding: 72px 0;
  }

  .eyebrow {
    color: var(--color-gold);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .section-title {
    color: var(--color-gold);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin-top: 8px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 32px;
    border-radius: 999px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    border: 2px solid transparent;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn-gold {
    background-color: var(--color-gold);
    color: var(--color-black);
  }

  .btn-gold:hover {
    box-shadow: 0 10px 30px -10px rgba(201, 168, 76, 0.6);
  }

  .btn-bone {
    background-color: transparent;
    color: var(--color-bone);
    border-color: var(--color-bone);
  }

  .btn-bone:hover {
    background-color: var(--color-bone);
    color: var(--color-black);
  }
</style>
