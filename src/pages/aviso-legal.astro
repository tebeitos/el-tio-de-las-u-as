---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingButton from '../components/FloatingButton.astro';
---

<Layout title="Aviso legal · El Tío de las Uñas" description="Aviso legal de El Tío de las Uñas, salón de uñas en Gijón.">
  <Header />
  <main class="legal section container">
    <h1 class="legal-title">Aviso legal</h1>
    <p class="legal-text">
      Contenido de próxima publicación. Aquí se incluirá la información legal de
      El Tío de las Uñas conforme a la normativa vigente.
    </p>
  </main>
  <Footer />
  <FloatingButton />
</Layout>

<style>
  .legal {
    min-height: 40vh;
    padding-top: 96px;
  }

  .legal-title {
    font-family: var(--font-heading);
    font-style: italic;
    font-weight: 400;
    color: var(--color-charcoal);
    font-size: clamp(2rem, 5vw, 2.8rem);
  }

  .legal-text {
    margin-top: 24px;
    max-width: 60ch;
    color: rgba(42, 37, 33, 0.75);
    font-size: 1rem;
  }
</style>
